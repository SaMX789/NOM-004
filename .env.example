# Copia este archivo como .env y completa los valores (nunca subas .env a Git)

# Supabase (Auth + Base de datos + Storage bucket 'equipos-fotos')
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# n8n · Arquitectura de 3 Webhooks Independientes
# Webhook 1 (Fase 1): Pre-análisis visual (recibe URL de imagen -> devuelve nombre_equipo y descripcion)
VITE_N8N_PRE_ANALYSIS_URL=
# Webhook 2 (Fase 2): Análisis profundo en texto 1 a 1 (recibe exposición -> devuelve riesgos y matriz NOM-004)
VITE_N8N_DEEP_ANALYSIS_URL=
# Webhook 3 (Fase 3): Generación de reporte Word (recibe arreglo de equipos 'completado' -> devuelve Blob .doc)
VITE_N8N_GENERATE_DOC_URL=

# Secreto compartido enviado en el header 'X-Webhook-Secret'
VITE_N8N_WEBHOOK_SECRET=
